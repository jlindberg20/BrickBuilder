{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickbuilder.ai/schemas/model_record.schema.json",
  "title": "BrickBuilder Model Record",
  "type": "object",
  "additionalProperties": true,

  "required": ["id", "type", "source_ids", "name", "metadata", "geometry", "bom", "instructions"],

  "properties": {
    "id": {
      "type": "string",
      "description": "Canonical model ID. Preferred format: model:rb:<set_num> when a Rebrickable set is known; else model:ldraw:<file_stem>."
    },

    "type": {
      "type": "string",
      "enum": ["model", "alt_model", "moc"],
      "description": "Model class; default and most common is 'model'."
    },

    "source_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "set_num": { "type": "string", "description": "Rebrickable set number, e.g. '60000-1'." }
          }
        },
        "ldraw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root_file": { "type": "string", "description": "Repo-relative path to the .ldr/.mpd file that defines the model." },
            "file_stem": { "type": "string", "description": "Convenience stem (basename without extension)." }
          },
          "required": ["root_file"]
        },
        "lego": { "type": "object" },
        "bricklink": { "type": "object" },
        "brickowl": { "type": "object" }
      }
    },

    "name": { "type": "string" },

    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["piece_count"],
      "properties": {
        "theme_id": { "type": ["integer", "string"] },
        "theme": { "type": "string" },
        "year": { "type": ["integer", "string"] },
        "piece_count": { "type": "integer", "minimum": 0 },
        "author": { "type": "string" },
        "last_updated": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-form breadcrumbs of how/where this model was derived."
        }
      }
    },

    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ldraw"],
      "properties": {
        "ldraw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_file", "scale"],
          "properties": {
            "root_file": { "type": "string", "description": "Same as source_ids.ldraw.root_file; repeated here for locality." },
            "scale": {
              "type": "object",
              "additionalProperties": false,
              "required": ["units", "to_mm"],
              "properties": {
                "units": { "type": "string", "enum": ["LDU"], "description": "LDraw units (LDU) in source files." },
                "to_mm": { "type": "number", "const": 0.4, "description": "LDU→mm scale factor." }
              }
            }
          }
        },
        "final_bbox_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/vec3" },
            "max": { "$ref": "#/$defs/vec3" }
          },
          "description": "Axis-aligned bounding box of the fully assembled model, in millimeters."
        },
        "triangles_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total triangle count of the fully assembled model (optional)."
        }
      }
    },

    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qty"],
        "properties": {
          "part_id": { "type": "string", "description": "Canonical ID in master_parts.jsonl, e.g. 'part:rb:<part_num>'." },
          "rb_part_num": { "type": "string", "description": "Rebrickable part number (fallback when part_id unresolved at parse-time)." },
          "rb_color_id": { "type": ["integer", "string"] },
          "color_rgb_hex": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
          "qty": { "type": "integer", "minimum": 1 }
        },
        "oneOf": [
          { "required": ["part_id"] },
          { "required": ["rb_part_num"] }
        ]
      }
    },

    "steps": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_num", "placements"],
            "properties": {
              "step_num": { "type": "integer", "minimum": 1 },
              "annotations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "placements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "part_id": { "type": "string" },
                    "rb_part_num": { "type": "string" },
                    "rb_color_id": { "type": ["integer", "string"] },
                    "qty": { "type": "integer", "minimum": 1, "default": 1 },
                    "transform": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "position_mm": { "$ref": "#/$defs/vec3" },
                        "rotation_deg": { "$ref": "#/$defs/vec3" }
                      }
                    },
                    "submodel_ref": { "type": "string", "description": "If this placement is a submodel instance." }
                  },
                  "oneOf": [
                    { "required": ["part_id"] },
                    { "required": ["rb_part_num"] },
                    { "required": ["submodel_ref"] }
                  ]
                }
              }
            }
          }
        }
      ],
      "description": "Ordered build steps. Null when no explicit STEP data exists (BOM-only)."
    },

    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "type": "string", "enum": ["ldraw", "pdf", "image_seq", "reference", "other"] },
        "source": { "type": "string", "description": "Path or URL to the instruction source." },
        "pages": { "type": ["integer", "null"] },
        "parsed_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },

    "links": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "master_parts_version": { "type": "string" },
        "parser_version": { "type": "string" },
        "build_tools": { "type": "string" }
      }
    }
  },

  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
